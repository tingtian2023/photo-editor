# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env — it holds secrets.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Shared access code. The app asks for it once, then sends it with every request.
# Must be at least 16 characters. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
APP_TOKEN=generate_a_long_random_code

# Browser origins allowed to call the API (comma-separated).
# Leave unset to allow all origins. http://localhost:5173 is the local dev server.
# ALLOWED_ORIGINS=https://<your-github-user>.github.io,http://localhost:5173
